# Parse native Dolt commit timestamps on the same UTC basis as containers.
TZ=UTC
# Red local development POC. Configuration shape only; no deployed secrets.
# Copy to .env.local (gitignored) and configure fresh local credentials.
# Prerequisite: prepared LOCAL PostgreSQL, Doltgres, Redis, Temporal,
# scheduler-worker and Red gateway. This repo does not install that substrate.
# Guide: https://cognidao.org/knowledge/inbox/contrib-flock-leader-conductor-32ab8994
NODE_ENV=development
APP_ENV=production
DEPLOY_ENVIRONMENT=local
PORT=3300
LANGGRAPH_PORT=2026
APP_BASE_URL=http://127.0.0.1:3300
NEXTAUTH_URL=http://127.0.0.1:3300
LANGGRAPH_DEV_URL=http://127.0.0.1:2026

# Distinct Red-owned roles. Only migrations use the owner DSN.
DATABASE_URL=postgresql://app_red:replace-me@127.0.0.1:55432/cogni_red
DATABASE_SERVICE_URL=postgresql://service_red:replace-me@127.0.0.1:55432/cogni_red
DATABASE_MIGRATION_URL=postgresql://migration_red:replace-me@127.0.0.1:55432/cogni_red
# Doltgres engine role is separate from PostgreSQL runtime-role restrictions.
DOLTGRES_URL=postgresql://postgres:replace-me@127.0.0.1:5435/knowledge_red
REDIS_URL=redis://127.0.0.1:6379
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=cogni-local
TEMPORAL_TASK_QUEUE=scheduler-tasks
SCHEDULER_WORKER_HEALTH_URL=http://127.0.0.1:9001
# Shared LOCAL worker route must map Red UUID to http://host.docker.internal:3300.
# Red UUID: 921b1d1d-4ded-4a6d-b3f1-f7d6affa406a
SCHEDULER_API_TOKEN=replace-me-with-at-least-32-local-characters

# Generate auth locally (openssl rand -hex 32); match billing token to Red gateway.
AUTH_SECRET=replace-me-with-at-least-32-local-characters
BILLING_INGEST_TOKEN=replace-me-with-at-least-32-local-characters
LITELLM_BASE_URL=http://127.0.0.1:4002
LITELLM_MASTER_KEY=sk-replace-me-with-fresh-local-red-gateway-key
# Gateway primary must be Red UUID; callbacks go to host.docker.internal:3300.
EVM_RPC_URL=https://mainnet.base.org
DB_POOL_MAX=1
DB_SERVICE_POOL_MAX=2
GOVERNANCE_SCHEDULES_ENABLED=false
MCP_CONFIG_PATH=./config/mcp.servers.json
# Optional authorized development project; never commit its key.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-me-with-your-development-key
# LANGSMITH_PROJECT=replace-me-with-your-development-project
# Leave DOLTHUB_REMOTE_URL unset. Do not push local data to a deployed hub.
# Red sandbox tool checks need a separately configured LOCAL sandbox. The poet
# canary does not prove red-solver's sandbox/host tool bindings.
